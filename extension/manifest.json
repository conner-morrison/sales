{
  "manifest_version": 3,
  "name": "LinkedIn Harvester",
  "version": "2.2.74",
  "description": "Captures Sales Navigator search results and reads lead pages in your logged-in browser, scores them against your persona locally, and sends the qualified URLs to the relay server.",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "downloads",
    "unlimitedStorage",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://relay-production-7643.up.railway.app/*",
    "https://api.telegram.org/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/sales/search/*"
      ],
      "js": [
        "capture.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.linkedin.com/sales/lead/*"
      ],
      "js": [
        "lead.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Harvester",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
